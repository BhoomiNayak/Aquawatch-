# Database
DATABASE_URL=postgresql://aquawatch:aquawatch_dev@localhost:5433/aquawatch

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=false

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Roboflow (optional - get key from https://app.roboflow.com)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=drone-water-quality-monitor/1
# Authority alerting (original-vision feature)
# Alerts are human-in-the-loop: HIGH-risk reports create a *candidate* that an
# operator must confirm. Dry-run (default) composes/stores the message but never sends.
ALERTS_ENABLED=true
ALERTS_DRY_RUN=true
ALERTS_MIN_LEVEL=high
# SMTP is only used when ALERTS_DRY_RUN=false AND an operator confirms a send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aquawatch-alerts@example.org
